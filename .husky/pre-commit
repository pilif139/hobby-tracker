pnpm lint-staged

FRONTEND_CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "^frontend/.*(\.ts|\.tsx|\.js|\.jsx|\.json)$" || true)
BACKEND_CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "^backend/.*(\.ts|\.js|\.json)$" || true)

if [ -n "$FRONTEND_CHANGED" ]; then
  echo "Type checking frontend:"
  pnpm -F frontend check-types
fi

if [ -n "$BACKEND_CHANGED" ]; then
  echo "Type checking backend:"
  pnpm -F backend check-types
fi
