{
  "name": "hobby-tracker",
  "version": "1.0.0",
  "author": "Filip Kasperski",
  "workspaces": [
    "backend",
    "frontend",
    "lib"
  ],
  "scripts": {
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"process.exit(0)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.0",
    "typescript-eslint": "^8.53.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>semver": "7.3.8",
      "eslint>minimatch": "3.1.5",
      "eslint>brace-expansion": "1.1.11",
      "@eslint/config-array>minimatch": "3.1.5",
      "@eslint/config-array>brace-expansion": "1.1.11",
      "@eslint/eslintrc>minimatch": "3.1.5"
    }
  }
}
