{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --environment node",
    "lint:fix": "eslint --fix",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "seed": "bun run src/db/seed.ts"
  },
  "prisma": {
    "seed": "bun run seed"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.4",
    "@hono/standard-validator": "^0.2.2",
    "@prisma/adapter-d1": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@scalar/hono-api-reference": "^0.9.37",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "hono": "^4.11.4",
    "hono-openapi": "^1.3.0",
    "lib": "workspace:*",
    "wrangler": "^4.59.2",
    "zod": "^4.3.5",
    "zod-openapi": "4"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,yaml,yml}": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@hono/eslint-config": "^2.0.5",
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "prisma": "^7.2.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.0",
    "typescript": "6.0.3"
  }
}
