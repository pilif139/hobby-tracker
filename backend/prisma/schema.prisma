// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hobbies       Hobby[]
  hobbySessions HobbySession[]

  uploadedObjects StorageObject[] @relation("UploadedBy")

  avatarId String?        @unique
  avatar   StorageObject? @relation("Avatar", fields: [avatarId], references: [id], onDelete: SetNull)

  follows    Follow[] @relation("Following")
  followedBy Follow[] @relation("Follower")

  @@index([name])
}

model Follow {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, followingId])
}

model Hobby {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  hobbySessions HobbySession[]

  @@index([name])
}

model HobbySession {
  id        String   @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hobbyId String
  hobby   Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storageObjects HobbySessionStorageObject[]

  @@index([userId, hobbyId, createdAt(sort: Desc)])
}

// 1:n relation by adding unique constraint to a theoretical many-to-many table field so that only one session can be linked to a storage object, but a session can have multiple storage objects 
model HobbySessionStorageObject {
  hobbySessionId String
  hobbySession   HobbySession @relation(fields: [hobbySessionId], references: [id], onDelete: Cascade)

  storageObjectId String        @id
  storageObject   StorageObject @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)

  @@index([hobbySessionId])
}

model StorageObject {
  id          String   @id @default(uuid())
  objectKey   String   @unique
  bucket      String
  contentType String?
  size        Int
  etag        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploadedByUserId String?
  uploadedByUser   User?   @relation("UploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  avatarForUser     User?                       @relation("Avatar")
  hobbySessionsLink HobbySessionStorageObject[]

  @@index([uploadedByUserId, bucket])
  @@index([createdAt(sort: Desc)])
}
